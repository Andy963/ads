# ADS 可以不配置任何 .env 直接运行（优先读取 ~/.codex、设备登录等）。
# 也可通过 CODEX_HOME 覆盖 Codex 的数据目录（默认 ~/.codex），用于放置 sessions/config/auth/skills。
# Claude 也会自动读取本机配置：
# - Claude: ~/.claude/config.json / auth.json / settings.json
# 只有当你要启用“可选能力”（Telegram/Web/联网搜索）时，才需要在这里配置。
# 全量/高级配置见：.env.advanced.example

# --- Telegram Bot（仅在运行 ads telegram / ads-telegram 时需要） ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=123456789
# TELEGRAM_ALLOWED_USERS=123456789  # legacy alias (single value only)
# ALLOWED_DIRS=/absolute/path/to/your/workspace  # 默认 current working dir

# --- Web Task 通知到 Telegram（可选） ---
# Web Console 任务终态通知会复用上面的 Telegram 配置，并发送到 TELEGRAM_ALLOWED_USER_ID（chat_id=user_id）。

# --- Web Console（可选） ---
# 鉴权由 `npm run web:init-admin` 创建的管理员账户 + session cookie 提供，无"关闭鉴权"开关。
# ADS_WEB_HOST=0.0.0.0
# ADS_WEB_PORT=8787
# 公网部署（如经 frps 反代）务必设置以下三项：
# ADS_WEB_ALLOWED_ORIGINS=https://your-domain   # 未设置时仅放行同源/localhost
# ADS_WEB_SESSION_PEPPER=please-change-me        # session token hash pepper
# ADS_WEB_COOKIE_SECURE=1                          # 经 HTTPS 暴露时强制 Secure cookie

# --- Codex（可选） ---
# CODEX_HOME=~/.codex

# --- 联网搜索（可选；仅供 Tavily skill 脚本使用） ---
# 提示：联网搜索与 URL 抓取仅通过 `.agent/skills/tavily-research/scripts/tavily-cli.cjs` 提供。
# TAVILY_BASE_URL=https://your-tavily-gateway.example
# TAVILY_API_TOKEN=

# --- 凭证覆盖（可选；一般不需要，优先用 ~/.claude） ---
# CLAUDE_API_KEY=
