#!/usr/bin/env bash
set -euo pipefail

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref on stdin. The guard inspects the remote target instead of the checked-out
# branch, so "git push origin main:refs/heads/main" from 'dev' is checked too.
protected_ref="refs/heads/main"
zero_sha="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  [[ "$remote_ref" == "$protected_ref" ]] || continue

  if [[ "$local_sha" == "$zero_sha" ]]; then
    echo "ERROR: deleting '$protected_ref' is blocked." >&2
    status=1
    continue
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    continue
  fi

  if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    echo "ERROR: remote head of '$protected_ref' is unknown locally." >&2
    echo "Remote head: $remote_sha" >&2
    echo "Run 'git fetch origin main' and retry." >&2
    status=1
    continue
  fi

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "ERROR: non-fast-forward update of '$protected_ref' is blocked." >&2
    echo "Local ref:  $local_ref ($local_sha)" >&2
    echo "Remote head: $remote_sha" >&2
    status=1
  fi
done < <(cat)

exit "$status"
