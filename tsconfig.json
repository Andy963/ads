{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "ts-server/dist",
    "sourceMap": true,

    // Additional strict checks
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "ts-server"
  },
  "include": ["ts-server/server", "ts-server/shared"],
  "exclude": ["node_modules", "ts-server/dist", "ts-server/tests", "docs"]
}
